rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isDevEmail() {
      return isAuth() && request.auth.token.email in [
        'mister11.app@gmail.com',
        'lanuevaolarecord@gmail.com',
        'jhocao111294@gmail.com',
        'jhocatv@gmail.com',
        'lavozdelformador@gmail.com'
      ];
    }
    // ── Reglas Universales para Jugadores y Rendimiento Deportivo ──────────────
    match /{path=**}/players/{playerId} {
      allow read, write: if isAuth();
    }
    match /{path=**}/wellness/{docId} {
      allow read, write: if isAuth();
    }
    match /{path=**}/test_results/{docId} {
      allow read, write: if isAuth();
    }
    match /{path=**}/evaluaciones/{docId} {
      allow read, write: if isAuth();
    }
    match /{path=**}/attendance/{docId} {
      allow read, write: if isAuth();
    }
    match /{path=**}/sessions/{docId} {
      allow read, write: if isAuth();
    }

    // ── Configuración global (lectura pública para comprobar versión del APK y descarga) ──
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Datos de usuario ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId) || isDevEmail();

      // Equipos personales del usuario (Límites por plan: Free 1, Pro 3, Club 40)
      match /teams/{teamId} {
        allow read, write: if isAuth();

        // Jugadores del equipo y todas sus subcolecciones (wellness, tests, asistencias, etc.)
        match /players/{playerId} {
          allow read, write: if isAuth();

          match /{allPlayerSubPaths=**} {
            allow read, write: if isAuth();
          }
        }

        match /{subcollection}/{docId} {
          allow read, write: if isAuth();
        }

        match /{subcollection}/{docId}/{allSubPaths=**} {
          allow read, write: if isAuth();
        }
      }

      // Subcollections adicionales del usuario
      match /{subcollection}/{docId} {
        allow read, write: if isAuth();
      }
    }

    // ── Partidos y Estadísticas en Vivo (Live Stats) ─────────────────────────
    match /matches/{matchId} {
      allow read, write: if isAuth();

      match /{allPaths=**} {
        allow read, write: if isAuth();
      }
    }

    // ── Clubs ─────────────────────────────────────────────────────────────────
    match /clubs/{clubId} {
      // Cualquier usuario autenticado puede leer datos del club (para invitaciones)
      allow read: if isAuth();

      // Solo el propietario del club (owner) o devs pueden modificar el club
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        isDevEmail() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubRole', '') == 'owner'
      );

      // Equipos del club
      match /teams/{teamId} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          isDevEmail() ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubRole', '') in ['owner', 'admin', 'coach']
        );

        // Subcolecciones de jugadores en equipos de club
        match /players/{playerId} {
          allow read, update, delete: if isAuth();
          allow create: if isAuth();

          match /{allPlayerSubPaths=**} {
            allow read, write: if isAuth();
          }
        }

        // Subcolecciones a cualquier profundidad dentro de equipos de club (ej. matches/{matchId}/liveStats, sessions, test_results, evaluaciones, etc.)
        match /{subcollection}/{allPaths=**} {
          allow read, write: if isAuth();
        }
      }

      // Miembros del club
      match /members/{memberId} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          isDevEmail() ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubRole', '') == 'owner'
        );
      }
    }

    // ── Stripe / Customers (solo el propio usuario y el backend) ─────────────
    match /customers/{userId} {
      allow read: if isOwner(userId) || isDevEmail();
      // Las checkout_sessions las crea el cliente, subscriptions las gestiona el webhook
      allow create: if isOwner(userId);
      allow update, delete: if isDevEmail();

      match /checkout_sessions/{sessionId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if isDevEmail();
      }

      match /subscriptions/{subId} {
        allow read: if isOwner(userId) || isDevEmail();
        allow write: if isDevEmail();
      }

      match /payments/{paymentId} {
        allow read: if isOwner(userId) || isDevEmail();
        allow write: if isDevEmail();
      }
    }

    // ── Códigos promocionales ─────────────────────────────────────────────────
    match /promoCodes/{codeId} {
      allow read: if isAuth();
      // Solo devs pueden crear/modificar códigos
      allow write: if isDevEmail();
    }

    // ── Planes compartidos (SharedPlan) y Sesiones compartidas (SharedSession) ──
    match /sharedPlans/{planId} {
      // Públicos en lectura y escritura para permitir compartir planes mediante enlace
      allow read, create, update: if true;
      allow delete: if isAuth();
    }

    match /sharedSessions/{shareId} {
      // Públicos en lectura y escritura para permitir compartir e importar mediante enlace sin requerir auth previo
      allow read, create, update: if true;
      allow delete: if isAuth();
    }

    // ── Invitaciones ──────────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.invitedBy == request.auth.uid;
      allow update, delete: if isAuth() && (
        isDevEmail() ||
        resource.data.get('invitedBy', '') == request.auth.uid ||
        resource.data.get('invitedEmail', '') == request.auth.token.email
      );
    }

    // ── Invitaciones de Cuerpo Técnico (Staff Invitations) ─────────────────────
    match /staff_invitations/{invitationId} {
      allow read: if true;
      allow create, update: if isAuth();
      allow delete: if isAuth();
    }

    // ── Códigos de Equipo Públicos para Portal del Jugador ───────────────────
    match /team_codes/{codeId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Notificaciones ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, write: if isAuth() && (
        isDevEmail() ||
        resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
    }

  }
}

