rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper de Autenticación ───────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── PARTE A: BLINDAJE TOTAL DE IDENTIDAD DETERMINISTA ────────────────────
    match /playerIdentity/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /playerIdentityByEmail/{emailNorm} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.uid == null;
      allow delete: if false;
    }

    // ── PARTE B: TOKENS DE NOTIFICACIONES PUSH Y PREFERENCIAS ─────────────────
    match /users/{userId}/pushTokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/prefs/{prefDoc} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/join_requests/{reqId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/shared_teams/{teamId} {
      allow read, write: if isOwner(userId) || isAuth();
    }

    // ── Configuración global y enlaces compartidos (acceso público) ──────────
    match /config/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /sharedPlans/{planId} {
      allow read, create, update: if true;
      allow delete: if isAuth();
    }

    match /sharedSessions/{shareId} {
      allow read, create, update: if true;
      allow delete: if isAuth();
    }

    match /team_codes/{codeId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /staff_invitations/{invitationId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /invitations/{token} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Reglas de Stripe Checkout y Clientes (Firebase Stripe Extension) ──────
    match /customers/{uid} {
      allow read, write: if isOwner(uid);

      match /checkout_sessions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /subscriptions/{id} {
        allow read: if isOwner(uid);
      }
      match /payments/{id} {
        allow read: if isOwner(uid);
      }
    }

    // ── Equipos de Usuario y Gestión de Jugadores / Familias ──────────────────
    match /users/{userId}/teams/{teamId} {
      allow read, write: if isAuth();

      match /players/{playerId} {
        allow read: if isAuth();
        allow write: if isAuth();

        match /{subcollection=**} {
          allow read, write: if isAuth();
        }
      }

      match /joinRequests/{reqId} {
        allow create: if isAuth();
        allow read, write: if isAuth();
      }

      match /{subcollection=**} {
        allow read, write: if isAuth();
      }
    }

    // ── Equipos de Club ──────────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read, write: if isAuth();

      match /teams/{teamId} {
        allow read, write: if isAuth();

        match /players/{playerId} {
          allow read, write: if isAuth();

          match /{subcollection=**} {
            allow read, write: if isAuth();
          }
        }

        match /joinRequests/{reqId} {
          allow create: if isAuth();
          allow read, write: if isAuth();
        }

        match /{subcollection=**} {
          allow read, write: if isAuth();
        }
      }

      match /{subcollection=**} {
        allow read, write: if isAuth();
      }
    }

    // ── Regla General para Usuarios Autenticados ─────────────────────────────
    match /{document=**} {
      allow read, write: if isAuth();
    }

  }
}
