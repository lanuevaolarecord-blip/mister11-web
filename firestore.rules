rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper de Autenticación ───────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── DEF-B2: Age-Gate de Seguridad Clínica en Persistencia (Menores) ───────
    // Umbrales canónicos de edad mínima por ejercicio (derivados de B3):
    //   • 16+ años: hex-064 (Drop Jump), hex-065 (Single-Leg Land), hex-092 (Deep Squat Jump)
    //   • 14+ años: sys-4 (Nordic), sys-5 (Copenhagen), hex-076 (Copenhagen banco), hex-078 (Nordic asistido), hex-108 (Cervical GK)
    //   • 12+ años: sys-6 (Sentadilla Búlgara), sys-7 (Peso Muerto Unipodal), hex-057 (Saltos Cruz), hex-077 (Copenhagen suelo)

    function getRestricted16Exercises() {
      return ['hex-064', 'hex-065', 'hex-092'];
    }

    function getRestricted14Exercises() {
      return ['sys-4', 'sys-5', 'hex-076', 'hex-078', 'hex-108'];
    }

    function getRestricted12Exercises() {
      return ['sys-6', 'sys-7', 'hex-057', 'hex-077'];
    }

    function isPlanAgeSafe(data) {
      let playerAge = 'playerAge' in data ? data.playerAge : 
                      ('age' in data ? data.age : 
                      ('edad' in data ? data.edad : 0));
      
      let ids = 'exerciseIds' in data ? data.exerciseIds : [];

      return playerAge >= 16 ? true :
             playerAge >= 14 ? !ids.hasAny(getRestricted16Exercises()) :
             playerAge >= 12 ? (!ids.hasAny(getRestricted16Exercises()) && !ids.hasAny(getRestricted14Exercises())) :
             (!ids.hasAny(getRestricted16Exercises()) && !ids.hasAny(getRestricted14Exercises()) && !ids.hasAny(getRestricted12Exercises()));
    }

    // ── PARTE A: BLINDAJE TOTAL DE IDENTIDAD DETERMINISTA ────────────────────
    match /playerIdentity/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /playerIdentityByEmail/{emailNorm} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.uid == null;
      allow delete: if false;
    }

    // ── PARTE B: TOKENS DE NOTIFICACIONES PUSH Y PREFERENCIAS ─────────────────
    match /users/{userId}/pushTokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/prefs/{prefDoc} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/join_requests/{reqId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/shared_teams/{teamId} {
      allow read, write: if isOwner(userId) || isAuth();
    }

    // ── Configuración global y enlaces compartidos (acceso público) ──────────
    match /config/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Colecciones compartidas endurecidas (B2: Membresía / Rol de Staff) ───
    match /sharedPlans/{planId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && 
        (resource.data.coachUid == request.auth.uid || 
         resource.data.createdBy == request.auth.uid || 
         !('coachUid' in resource.data));
      allow delete: if isAuth() && 
        (resource.data.coachUid == request.auth.uid || 
         resource.data.createdBy == request.auth.uid);
    }

    match /sharedSessions/{shareId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && 
        (resource.data.coachUid == request.auth.uid || 
         resource.data.createdBy == request.auth.uid || 
         !('coachUid' in resource.data));
      allow delete: if isAuth() && 
        (resource.data.coachUid == request.auth.uid || 
         resource.data.createdBy == request.auth.uid);
    }

    match /team_codes/{codeId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.coachUid == request.auth.uid;
      allow update: if isAuth() && 
        (resource.data.coachUid == request.auth.uid || request.resource.data.coachUid == request.auth.uid);
      allow delete: if isAuth() && resource.data.coachUid == request.auth.uid;
    }

    match /staff_codes/{codeId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && 
        (resource.data.ownerId == request.auth.uid || resource.data.coachUid == request.auth.uid);
    }

    match /teams/{teamId} {
      allow read: if isAuth() && 
        (resource.data.ownerId == request.auth.uid || 
         resource.data.members[request.auth.uid] != null ||
         resource.data.staffMembers[request.auth.uid] != null);
      
      allow write: if isAuth();

      // ── Planes individuales y de equipo (Age-Gate B2) ───────────────
      match /playerPlans/{planId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
        allow delete: if isAuth();
      }

      match /teamPlans/{planId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
        allow delete: if isAuth();
      }

      match /sessions/{sessionId} {
        allow read, write: if isAuth();
      }

      match /{subcollection=**} {
        allow read, write: if isAuth();
      }
    }

    match /staff_invitations/{invitationId} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /invitations/{token} {
      allow read: if true;
      allow create, update, delete: if isAuth();
    }

    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAuth();
    }

    // ── Reglas de Stripe Checkout y Clientes (Firebase Stripe Extension) ──────
    match /customers/{uid} {
      allow read, write: if isOwner(uid);

      match /checkout_sessions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /subscriptions/{id} {
        allow read: if isOwner(uid);
      }
      match /payments/{id} {
        allow read: if isOwner(uid);
      }
    }

    // ── Equipos de Usuario y Gestión de Jugadores / Familias ──────────────────
    match /users/{userId}/teams/{teamId} {
      allow read, write: if isAuth();

      match /players/{playerId} {
        allow read: if isAuth();
        allow write: if isAuth();

        // ── Subcolección de sesiones cognitivas del jugador ───────────
        match /cognitive/{sessionId} {
          allow read: if isAuth();
          allow create, update: if isAuth();
          allow delete: if isOwner(userId);
        }

        match /{subcollection=**} {
          allow read, write: if isAuth();
        }
      }

      // ── Planes individuales y de equipo (Age-Gate B2) ───────────────
      match /playerPlans/{planId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
        allow delete: if isAuth();
      }

      match /teamPlans/{planId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
        allow delete: if isAuth();
      }

      // ── Asignaciones de Juegos y Retos recomendados ────────────────
      match /gameAssignments/{assignId} {
        allow read: if isAuth();
        allow write: if isAuth();
      }

      match /joinRequests/{reqId} {
        allow create: if isAuth();
        allow read, write: if isAuth();
      }

      // ── Partidos: protección del campo actaOficial ──────────────────────────
      // Un jugador SOLO puede escribir `playerRsvp` (su propia clave).
      // La sub-estructura `actaOficial` (pase de lista, minutos, closed) es
      // EXCLUSIVA del staff. Se detecta si el request toca actaOficial:
      //   • Si el diff de campos incluye `actaOficial.*` → require owner.
      //   • Si solo escribe `playerRsvp.*`               → cualquier auth.
      match /matches/{matchId} {
        allow read: if isAuth();

        // Staff (dueño del equipo) puede escribir todo
        allow write: if isOwner(userId);

        // Jugador autenticado puede escribir solo si NO toca actaOficial
        allow update: if isAuth()
          && !('actaOficial' in request.resource.data.diff(resource.data).affectedKeys());
      }

      // ── Sesiones de entrenamiento y calificaciones de jugadores por staff ──
      match /sessions/{sessionId} {
        allow read, write: if isAuth();

        match /ratings/{playerId} {
          allow read, write: if isAuth();
        }
      }

      // ── Control oficial de asistencia por el cuerpo técnico ────────────────
      match /attendance/{attId} {
        allow read, write: if isAuth();
      }

      match /{subcollection=**} {
        allow read, write: if isAuth();
      }
    }

    // ── Colección Raíz de Equipos (Ruta determinista /equipos/{teamId}) ───────
    match /equipos/{teamId} {
      allow read, write: if isAuth();

      // ── Planes individuales y de equipo (Age-Gate B2) ───────────────
      match /playerPlans/{planId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
        allow delete: if isAuth();
      }

      match /teamPlans/{planId} {
        allow read: if isAuth();
        allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
        allow delete: if isAuth();
      }

      match /sessions/{sessionId} {
        allow read, write: if isAuth();

        match /ratings/{playerId} {
          allow read, write: if isAuth();
        }
      }

      match /attendance/{attId} {
        allow read, write: if isAuth();
      }

      match /{subcollection=**} {
        allow read, write: if isAuth();
      }
    }

    // ── Equipos de Club ──────────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read, write: if isAuth();

      match /teams/{teamId} {
        allow read, write: if isAuth();

        match /players/{playerId} {
          allow read: if isAuth();
          allow write: if isAuth();

          match /cognitive/{sessionId} {
            allow read: if isAuth();
            allow create, update: if isAuth();
          }

          match /{subcollection=**} {
            allow read, write: if isAuth();
          }
        }

        // ── Planes individuales y de equipo (Age-Gate B2) ───────────────
        match /playerPlans/{planId} {
          allow read: if isAuth();
          allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
          allow delete: if isAuth();
        }

        match /teamPlans/{planId} {
          allow read: if isAuth();
          allow create, update: if isAuth() && isPlanAgeSafe(request.resource.data);
          allow delete: if isAuth();
        }

        match /gameAssignments/{assignId} {
          allow read: if isAuth();
          allow write: if isAuth();
        }

        match /joinRequests/{reqId} {
          allow create: if isAuth();
          allow read, write: if isAuth();
        }

        match /{subcollection=**} {
          allow read, write: if isAuth();
        }
      }

      match /{subcollection=**} {
        allow read, write: if isAuth();
      }
    }

    match /gameAssignments/{assignId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── Regla General para Usuarios Autenticados ─────────────────────────────
    match /{document=**} {
      allow read, write: if isAuth();
    }

  }
}
