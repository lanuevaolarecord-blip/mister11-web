rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // APK público: cualquiera puede leer y actualizar
    match /mister11.apk {
      allow read: if true;
      allow write: if true;
    }

    // Resto de archivos (fotos de jugadores, capturas de pizarra, etc.)
    // Solo usuarios autenticados, tipo imagen y tamaño máximo 5 MB.
    // Nota: las capturas de pizarra y avatares de jugadores son siempre imágenes
    // comprimidas con browser-image-compression, por lo que quedan por debajo del límite.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
